#!/bin/sh
#PBS -N sarvam_bhili_adivaani_4gpu
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -m bea
#PBS -M aiy257590@scai.iitd.ac.in
#PBS -l select=1:ncpus=16:ngpus=4
#PBS -l walltime=48:00:00

echo "==============================="
echo $PBS_JOBID
cat $PBS_NODEFILE
echo "==============================="
cd $HOME

cd "/home/scai/msr/aiy257590/flash/final-climb-adivaani/RECAP/for adivaani/bhili/sarvam"

source ~/.bashrc
conda activate sarvam

# All 4 Bhili directions (hi2tgt, tgt2hi, en2tgt, tgt2en) on the 2k/2k
# val/test adivaani split, one direction per GPU, run in parallel --
# sarvam_finetune.py's own GPU-pool (CUDA_VISIBLE_DEVICES pinned per
# worker, imports already deferred inside run_job()) already supports
# this directly, no script changes needed.
/home/scai/msr/aiy257590/.conda/envs/sarvam/bin/python sarvam_finetune.py \
    --langs bhili \
    --directions hi2tgt,tgt2hi,en2tgt,tgt2en
