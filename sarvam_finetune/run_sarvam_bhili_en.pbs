#!/bin/sh
#PBS -N sarvam_bhili_tgt2en
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -m bea
#PBS -M aiy257590@scai.iitd.ac.in
#PBS -l select=1:ncpus=16:ngpus=1
#PBS -l walltime=48:00:00

echo "==============================="
echo $PBS_JOBID
cat $PBS_NODEFILE
echo "==============================="
cd $HOME

cd /home/scai/msr/aiy257590/flash/final-climb-adivaani/RECAP/sarvam_finetune

source ~/.bashrc
conda activate sarvam

# Bhili tgt2en ONLY, 1 GPU -- en2tgt is already running separately
# (interactive session), so this just covers the other English direction
# instead of both, to avoid duplicating that work.
/home/scai/msr/aiy257590/.conda/envs/sarvam/bin/python sarvam_finetune.py \
    --langs Bhili \
    --directions tgt2en
