#!/bin/sh
#PBS -N spbleu_llama
#PBS -P misn.mota2.spons
#PBS -q high
#PBS -m bea
#PBS -M aiy257590@scai.iitd.ac.in
#PBS -l select=1:ncpus=32:ngpus=2
#PBS -l walltime=04:00:00

echo "==============================="
echo $PBS_JOBID
cat $PBS_NODEFILE
echo "==============================="
cd $HOME

cd /home/scai/msr/aiy257590/flash/final-climb-adivaani/RECAP

# Llama-3.1-8B inference, all 3 languages, val+test, all directions --
# given its own dedicated job since it's the heaviest model here (8B,
# beam=4) and would otherwise bottleneck whichever job it shared.
for lang in Bhili Mundari Gondi; do
    echo "--- Llama / $lang ---"
    (cd llama_finetune/$lang && conda run -n qwen_llama --no-capture-output python infer.py)
done

echo "Llama job done."
