#!/bin/sh
#PBS -N it2_batch1
#PBS -P misn.mota2.spons
#PBS -m bea
#PBS -M aiy257590@scai.iitd.ac.in
#PBS -l select=1:ncpus=16:ngpus=4
#PBS -l walltime=48:00:00

echo "==============================="
echo $PBS_JOBID
cat $PBS_NODEFILE
echo "==============================="
cd $HOME

cd /home/scai/msr/aiy257590/flash/final-climb-adivaani/RECAP/indictrans2_finetune

source ~/.bashrc
conda activate mt5

# Batch 1/2 of the IndicTrans2 sweep: Bhili + Mundari (2 langs x 2
# directions = 4 tasks on 4 GPUs, 1 task per GPU, zero idle GPU time).
# Run alongside run_indictrans2_batch2.pbs + both sarvam_finetune batch
# jobs (4 concurrent PBS jobs, 16 GPUs total) instead of one job covering
# all 8 IndicTrans2 directions alone -- see run_indictrans2_finetune.pbs
# for the single-job version and its full explanatory comments.
/home/scai/msr/aiy257590/.conda/envs/mt5/bin/python finetune_indictrans2.py \
    --server pragya \
    --langs Bhili,Mundari \
    --directions hi2tgt,tgt2hi
