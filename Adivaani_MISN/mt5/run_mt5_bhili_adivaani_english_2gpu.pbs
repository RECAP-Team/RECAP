echo "==============================="
echo $PBS_JOBID
cat $PBS_NODEFILE
echo "==============================="
cd $HOME

cd /home/scai/msr/aiy257590/flash/final-climb-adivaani/RECAP/Adivaani_MISN/mt5

source ~/.bashrc
conda activate mt5

# Re-run just the 2 English Bhili directions (en2tgt, tgt2en) on the cleaned
# Adivaani_MISN data (regenerated English column), one direction per GPU --
# see config.json. hi2tgt/tgt2hi checkpoints from the original 4-direction
# run are untouched; only the English-direction checkpoints were deleted
# before this run.
/home/scai/msr/aiy257590/.conda/envs/mt5/bin/python mt5_finetune.py
