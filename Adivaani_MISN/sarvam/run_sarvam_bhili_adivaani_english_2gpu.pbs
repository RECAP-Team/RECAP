#!/bin/sh
#PBS -N sarvam_bhili_adivaani_english_2gpu
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -m bea
#PBS -M aiy257590@scai.iitd.ac.in
#PBS -l select=1:ncpus=8:ngpus=2
#PBS -l walltime=48:00:00

echo "==============================="
echo $PBS_JOBID
cat $PBS_NODEFILE
echo "==============================="
cd $HOME

cd /home/scai/msr/aiy257590/flash/final-climb-adivaani/RECAP/Adivaani_MISN/sarvam

source ~/.bashrc
conda activate sarvam

# Re-run just the 2 English Bhili directions (en2tgt, tgt2en) on the cleaned
# Adivaani_MISN data (regenerated English column), one direction per GPU.
# hi2tgt/tgt2hi checkpoints from the original 4-direction run are untouched;
# only the English-direction checkpoints were deleted before this run.
/home/scai/msr/aiy257590/.conda/envs/sarvam/bin/python sarvam_finetune.py \
    --langs bhili \
    --directions en2tgt,tgt2en
