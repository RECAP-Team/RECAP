#!/bin/sh
#PBS -N sarvam_gondi_corrected_4gpu
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -m bea
#PBS -M aiy257590@scai.iitd.ac.in
#PBS -l select=1:ncpus=16:ngpus=4
#PBS -l walltime=48:00:00

echo "==============================="
echo $PBS_JOBID
cat $PBS_NODEFILE
echo "==============================="
cd $HOME

cd /home/scai/msr/aiy257590/flash/final-climb-adivaani/RECAP/correct_checkpoints/sarvam_translate

source ~/.bashrc
conda activate sarvam

# All 4 Gondi directions (hi2tgt, tgt2hi, en2tgt, tgt2en) on the CORRECTED
# dataset, one direction per GPU, run in parallel -- sarvam_finetune.py's
# own GPU-pool handles this directly via --langs/--directions, same shared
# script+config as Bhili/Mundari's jobs, just a separate job/GPU allocation
# for Gondi.
/home/scai/msr/aiy257590/.conda/envs/sarvam/bin/python sarvam_finetune.py \
    --langs gondi \
    --directions hi2tgt,tgt2hi,en2tgt,tgt2en
