echo "==============================="
echo $PBS_JOBID
cat $PBS_NODEFILE
echo "==============================="
cd $HOME

cd /home/scai/msr/aiy257590/flash/final-climb-adivaani/RECAP/correct_checkpoints/sarvam_translate

source ~/.bashrc
conda activate sarvam

# Bhili tgt2hi on the CORRECTED dataset (correct_checkpoints/dataset_corrected/bhili/)
# -- 1 direction, 1 GPU. See config.json for data/output paths.
/home/scai/msr/aiy257590/.conda/envs/sarvam/bin/python sarvam_finetune.py \
    --langs bhili \
    --directions tgt2hi
