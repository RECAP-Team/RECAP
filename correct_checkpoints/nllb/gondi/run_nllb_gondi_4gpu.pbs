#!/bin/sh
#PBS -N nllb_gondi_corrected_4gpu
#PBS -P misn.mota2.spons
#PBS -q standard
#PBS -m bea
#PBS -M aiy257590@scai.iitd.ac.in
#PBS -l select=1:ncpus=16:ngpus=4
#PBS -l walltime=48:00:00

echo "==============================="
echo $PBS_JOBID
cat $PBS_NODEFILE
echo "==============================="
cd $HOME

cd /home/scai/msr/aiy257590/flash/final-climb-adivaani/RECAP/correct_checkpoints/nllb/gondi

source ~/.bashrc
conda activate mt5

# All 4 Gondi directions (hi2tgt, tgt2hi, en2tgt, tgt2en) on the CORRECTED
# dataset, one direction per GPU, run in parallel -- see config.json.
# gon_Deva is a new vocab tag for NLLB (like Bhili's bhb_Deva), unlike
# Mundari's pretrained unr_Deva.
/home/scai/msr/aiy257590/.conda/envs/mt5/bin/python hb_pja_nllb_finetune.py
